{
  "name": "multitimer-vue",
  "private": true,
  "version": "8.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "vue-tsc && vite build --base=./",
    "check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "prebuild:default:bootstrap": "node ./node_modules/mie-design-system/set-css-lib.js bootstrap default",
    "prebuild:default:tailwind": "node ./node_modules/mie-design-system/set-css-lib.js tailwind default",
    "prebuild:default:default": "node ./node_modules/mie-design-system/set-css-lib.js default default",
    "prebuild:pink:bootstrap": "node ./node_modules/mie-design-system/set-css-lib.js bootstrap pink",
    "prebuild:pink:tailwind": "node ./node_modules/mie-design-system/set-css-lib.js tailwind pink",
    "prebuild:pink:default": "node ./node_modules/mie-design-system/set-css-lib.js default pink",
    "prebuild:green:bootstrap": "node ./node_modules/mie-design-system/set-css-lib.js bootstrap green",
    "prebuild:green:tailwind": "node ./node_modules/mie-design-system/set-css-lib.js tailwind green",
    "prebuild:green:default": "node ./node_modules/mie-design-system/set-css-lib.js default green",
    "build:default:bootstrap": "npm run prebuild:default:bootstrap && sass ./node_modules/mie-design-system/styles/main.scss:./main.css --no-source-map",
    "build:default:tailwind": "npm run prebuild:default:tailwind && sass ./node_modules/mie-design-system/styles/main.scss:./main.css --no-source-map",
    "build:default:default": "npm run prebuild:default:default && sass ./node_modules/mie-design-system/styles/main.scss:./main.css --no-source-map",
    "build:pink:bootstrap": "npm run prebuild:pink:bootstrap && sass ./node_modules/mie-design-system/styles/main.scss:./main.css --no-source-map",
    "build:pink:tailwind": "npm run prebuild:pink:tailwind && sass ./node_modules/mie-design-system/styles/main.scss:./main.css --no-source-map",
    "build:pink:default": "npm run prebuild:pink:default && sass ./node_modules/mie-design-system/styles/main.scss:./main.css --no-source-map",
    "build:green:bootstrap": "npm run prebuild:green:bootstrap && sass ./node_modules/mie-design-system/styles/main.scss:./main.css --no-source-map",
    "build:green:tailwind": "npm run prebuild:green:tailwind && sass ./node_modules/mie-design-system/styles/main.scss:./main.css --no-source-map",
    "build:green:default": "npm run prebuild:green:default && sass ./node_modules/mie-design-system/styles/main.scss:./main.css --no-source-map"
  },
  "dependencies": {
    "@azure/msal-browser": "^2.32.1",
    "@fortawesome/fontawesome-free": "^6.4.0",
    "@popperjs/core": "^2.11.6",
    "@types/bootstrap": "^5.2.6",
    "animejs": "^3.2.1",
    "bootstrap": "^5.2.3",
    "date-fns": "^2.29.3",
    "is-mobile": "^4.0.0",
    "mie-design-system": "^1.0.5",
    "sortablejs": "^1.15.0",
    "sortablejs-vue3": "^1.2.5",
    "vue": "^3.2.41"
  },
  "devDependencies": {
    "@types/animejs": "^3.1.12",
    "@types/date-fns": "^2.6.0",
    "@types/node": "^20.3.0",
    "@types/sortablejs": "^1.15.0",
    "@typescript-eslint/eslint-plugin": "^5.47.1",
    "@typescript-eslint/parser": "^5.47.1",
    "@vitejs/plugin-vue": "^4.0.0",
    "eslint": "^8.24.0",
    "eslint-plugin-vue": "^9.8.0",
    "prettier": "^2.7.1",
    "sass": "^1.55.0",
    "typescript": "^5.1.3",
    "unplugin-vue-components": "^0.25.1",
    "vite": "^4.0.0",
    "vue-tsc": "^1.0.9"
  }
}
